{
  "name": "icosa-viewer",
  "version": "0.7.3-alpha.2",
  "description": "Viewer for Tilt Brush / Open Brush files and derivatives",
  "scripts": {
    "watch": "parcel watch",
    "build": "parcel build --no-cache",
    "build:pinned": "parcel build --no-cache && shx cp \"node_modules/three-icosa/dist/three-icosa.module.js\" \"dist/three-icosa.module.js\" && shx cp \"node_modules/three-tiltloader/dist/three-tiltloader.module.js\" \"dist/three-tiltloader.module.js\"",
    "build:local": "parcel build --no-cache && shx cp \"../three-icosa/dist/three-icosa.module.js\" \"dist/three-icosa.module.js\" && shx cp \"../three-tiltloader/dist/three-tiltloader.module.js\" \"dist/three-tiltloader.module.js\"",
    "download-three-icosa": "curl -o dist/three-icosa.module.js https://cdn.jsdelivr.net/npm/three-icosa@0.4.2-alpha.18/dist/three-icosa.module.js",
    "setup-cdn": "node scripts/setup-cdn-importmap.js",
    "test": "npm run check:pins && npm run check:pinned-bundles && node npm-test.js",
    "check:pins": "node scripts/check-library-pins.mjs",
    "check:pinned-bundles": "node scripts/check-pinned-bundles.mjs",
    "test:browser:brush-passes": "node scripts/browser-brush-passes-smoke.mjs",
    "test:browser:imm": "node scripts/browser-imm-smoke.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/icosa-foundation/icosa-viewer.git"
  },
  "author": "Icosa Gallery",
  "license": "Apache-2.0",
  "module": "dist/icosa-viewer.module.js",
  "default": "src/icosa-viewer.js",
  "source": "src/viewer.ts",
  "sourceMaps": true,
  "targets": {
    "module": {
      "outputFormat": "esmodule",
      "isLibrary": true,
      "includeNodeModules": {
        "three": false,
        "three-tiltloader": false,
        "three-icosa": false,
        "@sparkjsdev/spark": false
      }
    }
  },
  "bugs": {
    "url": "https://github.com/icosa-foundation/icosa-viewer/issues"
  },
  "homepage": "https://github.com/icosa-foundation/icosa-viewer#readme",
  "devDependencies": {
    "@parcel/packager-ts": "^2.12.0",
    "@parcel/transformer-typescript-types": "^2.12.0",
    "@sparkjsdev/spark": "^2.1.0",
    "@types/three": "^0.185.4",
    "parcel": "^2.12.0",
    "playwright": "^1.61.1",
    "shx": "^0.3.4",
    "three": "^0.185.1",
    "typescript": "^5.4.5"
  },
  "dependencies": {
    "camera-controls": "^2.8.4",
    "hold-event": "0.0.1",
    "three-icosa": "https://github.com/icosa-foundation/three-icosa/archive/25fe4ca1f7e52174e7d9dca90c811e307216ba1f.tar.gz",
    "three-tiltloader": "https://github.com/icosa-foundation/three-tiltloader/archive/6c92f0035911e8e61755fec3270beb7604d5dc81.tar.gz"
  },
  "peerDependencies": {
    "@immersive-foundation/three-imm-loader": "*",
    "@sparkjsdev/spark": "^2.1.0",
    "three": ">=0.185 <0.186.0"
  },
  "peerDependenciesMeta": {
    "@immersive-foundation/three-imm-loader": {
      "optional": true
    },
    "@sparkjsdev/spark": {
      "optional": true
    }
  },
  "files": [
    "dist",
    "examples"
  ],
  "funding": {
    "type": "opencollective",
    "url": "https://opencollective.com/icosa"
  },
  "keywords": [
    "three",
    "three.js",
    "viewer",
    "openbrush",
    "tiltbrush",
    "creative",
    "camera",
    "vr",
    "xr"
  ]
}
